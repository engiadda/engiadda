NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:password@localhost:5432/engiadda
# Comma-separated exact origins only. GitHub Pages project sites use https://engiadda.github.io (no /engiadda path).
CORS_ORIGIN=http://localhost:5500,https://engiadda.github.io
# Set this to a long random secret in the API host and the job-agent GitHub Actions secret.
WEBSITE_WEBHOOK_TOKEN=replace-with-a-long-random-secret
# Set DB_SSL=true only when required by your database provider and its certificate chain is trusted.
DB_SSL=false
DB_POOL_MAX=10
